rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnerOf(championshipId) {
      return signedIn()
        && get(/databases/$(database)/documents/championships/$(championshipId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /championships/{championshipId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read, delete: if isOwnerOf(resource.data.championshipId);
      allow create, update: if isOwnerOf(request.resource.data.championshipId);
    }

    match /rounds/{roundId} {
      allow read, delete: if isOwnerOf(resource.data.championshipId);
      allow create, update: if isOwnerOf(request.resource.data.championshipId);
    }

    match /players/{playerId} {
      allow read, delete: if isOwnerOf(resource.data.championshipId);
      allow create, update: if isOwnerOf(request.resource.data.championshipId);
    }

    match /matches/{matchId} {
      allow read, delete: if isOwnerOf(resource.data.championshipId);
      allow create, update: if isOwnerOf(request.resource.data.championshipId);
    }
  }
}
