rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRoot() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ROOT';
    }

    function owns() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function becomingOwner() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isRoot());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'ADMIN';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{collection}/{document} {
      allow read: if collection in ['leagues', 'tournaments', 'seasons', 'teams', 'players', 'rounds', 'matches']
        && (isRoot() || owns());
      allow create: if collection in ['leagues', 'tournaments', 'seasons', 'teams', 'players', 'rounds', 'matches']
        && becomingOwner();
      allow update, delete: if collection in ['leagues', 'tournaments', 'seasons', 'teams', 'players', 'rounds', 'matches']
        && owns();
    }
  }
}
